# Modelo de variaveis de ambiente do site (SEM VALORES REAIS).
# Copie para .env e preencha. Tudo com prefixo VITE_ vai para o bundle
# publico do navegador — NUNCA colocar credencial privada aqui.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Storefront API access token da loja sonaracusticos.myshopify.com.
# 32 caracteres hexadecimais, SEM prefixo. Publico por design (somente leitura).
# Gerar em: Admin > Settings > Apps and sales channels > Develop apps
#           > (app) > Configuration > Storefront API > Install > Reveal token
VITE_SHOPIFY_STOREFRONT_TOKEN=

# ATENCAO: o Admin API token (shpat_...) NAO entra aqui e NUNCA recebe prefixo
# VITE_. Ele vive apenas em servers/shopify-mcp/.env, fora do site.

# Envio de orçamento — SOMENTE no ambiente de funções da Netlify.
# Não usar o prefixo VITE_: estas chaves nunca podem ir para o navegador.
# A função /.netlify/functions/quote-request envia a solicitação para a equipe e a confirmação para o cliente.
RESEND_API_KEY=
QUOTE_TO_EMAIL=contato@sonaracusticos.com.br
# O domínio do remetente precisa ser verificado no Resend.
QUOTE_FROM_EMAIL=Sonar Acústicos <orcamentos@sonaracusticos.com.br>
